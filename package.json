{
  "name": "bnb-era-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "ERC-8004 agent marketplace on BNB Smart Chain — Build the Era hackathon",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit",
